{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rbavionics.com/schemas/rb-llm/1/ask-response.schema.json",
  "title": "POST /v1/ask response",
  "type": "object",
  "required": [
    "protocol",
    "request_id",
    "status",
    "kind",
    "engine"
  ],
  "properties": {
    "protocol": {
      "$ref": "common.schema.json#/$defs/protocol"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/request_id"
    },
    "status": {
      "description": "ok: answer filled. refused: the model refused to use the status (answer holds the refusal; do not speak it). no_data: no aircraft status available. error: see error.",
      "type": "string",
      "enum": [
        "ok",
        "refused",
        "no_data",
        "error"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "ask",
        "unknown"
      ]
    },
    "answer": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "speak": {
          "type": [
            "string",
            "null"
          ]
        },
        "lang": {
          "$ref": "common.schema.json#/$defs/lang"
        }
      },
      "additionalProperties": false
    },
    "facts_used": {
      "description": "Keys of the status facts the model says it used.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status_source": {
      "type": "string",
      "enum": [
        "request",
        "rb",
        "demo",
        "none"
      ]
    },
    "engine": {
      "$ref": "common.schema.json#/$defs/engine_info"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    },
    "debug": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ]
}
